#!/usr/bin/env sh
#
# Repo pre-commit hook. `bun install` enables it through the `prepare` script
# (git config core.hooksPath .githooks).
#
# 1. Runs any globally configured pre-commit hook (e.g. a company secret
#    scanner). The repo-local core.hooksPath shadows the global one, so it is
#    re-invoked here to keep it working in this repo.
# 2. Strips private-registry proxy URLs from bun.lock when it is staged.
#    Vercel runs `bun install` and can't reach the proxy.
#    See .agents/rules/bun-clean-lock-rule.mdc.
# 3. Formats and lints staged files (lint-staged) and checks their links.
#
set -e

# GUI git clients don't load the shell profile; make Homebrew and Bun findable.
export PATH="$PATH:/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.bun/bin"

# --- 1) Run the globally configured pre-commit hook, if any ------------------
global_hooks="$(git config --global core.hooksPath 2>/dev/null || true)"
case "$global_hooks" in
  "~"*) global_hooks="$HOME${global_hooks#\~}" ;;
esac
if [ -n "$global_hooks" ] && [ -x "$global_hooks/pre-commit" ]; then
  "$global_hooks/pre-commit" "$@"
fi

# --- 2) Strip proxy URLs from bun.lock when staged ---------------------------
if git diff --cached --name-only | grep -qx 'bun.lock'; then
  bun scripts/strip-bun-lock-proxy.ts
  git add bun.lock
fi

# --- 3) Format/lint staged files and check their links -----------------------
bunx lint-staged
bun scripts/check-links.mjs --staged
