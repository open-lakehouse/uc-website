#!/usr/bin/env sh
#
# Repo pre-push hook. `bun install` enables it through the `prepare` script
# (git config core.hooksPath .githooks).
#
# 1. Runs any globally configured pre-push hook (e.g. a company secret
#    scanner). The repo-local core.hooksPath shadows the global one, so it is
#    re-invoked here to keep it working in this repo.
# 2. Blocks the push if bun.lock has private-registry proxy URLs in any commit
#    being pushed. Vercel deploys on push and can't reach the proxy, and the
#    proxy hostname shouldn't be published. The pre-commit hook strips
#    bun.lock, but doesn't run for `--no-verify` commits or rebases, so this is
#    the last local check. See .agents/rules/bun-clean-lock-rule.mdc.
#
set -e

# GUI git clients don't load the shell profile; make Homebrew and Bun findable.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.bun/bin:$PATH"

# git passes the refs being pushed on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# Both steps need them, so read them once.
refs="$(cat)"

# --- 1) Run the globally configured pre-push hook, if any --------------------
global_hooks="$(git config --global core.hooksPath 2>/dev/null || true)"
case "$global_hooks" in
  "~"*) global_hooks="$HOME${global_hooks#\~}" ;;
esac
if [ -n "$global_hooks" ] && [ -x "$global_hooks/pre-push" ]; then
  if [ -n "$refs" ]; then printf '%s\n' "$refs"; fi | "$global_hooks/pre-push" "$@"
fi

# --- 2) Block pushes with proxy URLs in bun.lock -----------------------------
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: 'bun' not found, so bun.lock can't be checked for proxy URLs." >&2
  echo "  Install Bun (https://bun.sh), or push with --no-verify if you're sure." >&2
  exit 1
fi

dirty=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_sha" ] || continue
  # An all-zero sha means the remote ref is being deleted: nothing to check.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  git cat-file -e "$local_sha^{commit}" 2>/dev/null || continue

  # The pushed tip (what Vercel builds), plus every commit not yet on any
  # remote that changed bun.lock. --full-history keeps side branches of merges.
  for commit in "$local_sha" $(git rev-list --full-history "$local_sha" --not --remotes -- bun.lock); do
    git cat-file -e "$commit:bun.lock" 2>/dev/null || continue
    if ! git show "$commit:bun.lock" | bun scripts/strip-bun-lock-proxy.ts --stdin >/dev/null 2>&1; then
      dirty="$dirty $commit"
    fi
  done
done <<EOF
$refs
EOF

if [ -n "$dirty" ]; then
  echo "pre-push: blocked. bun.lock has private-registry proxy URLs in:" >&2
  # shellcheck disable=SC2086 # word-splitting the commit list is intended
  git log --no-walk --format='  %h %s' $dirty >&2
  echo "Vercel can't reach the proxy, and the URLs shouldn't be published." >&2
  echo "  Fix the tip:     bun run strip-lock-proxy, then commit bun.lock" >&2
  echo "  Older commits:   amend, squash, or rebase so none of them keep the URLs" >&2
  echo "  See .agents/rules/bun-clean-lock-rule.mdc" >&2
  exit 1
fi
