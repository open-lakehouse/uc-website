    "@shikijs/rehype": "4.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.3.14",
    "@types/estree": "1.0.10",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
