{
  "name": "uc-website",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && bun scripts/postbuild.ts",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "bun scripts/content.ts && tsc --noEmit",
    "links": "bun scripts/check-links.mjs",
    "links:staged": "bun scripts/check-links.mjs --staged",
    "links:dist": "bun scripts/check-links.mjs --dist",
    "strip-lock-proxy": "bun scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy:check": "bun scripts/strip-bun-lock-proxy.ts --check",
    "postinstall": "bun scripts/strip-bun-lock-proxy.ts"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@open-lakehouse/trestle-diagram": "0.5.2",
    "@pagefind/default-ui": "1.6.0",
